---js
const layout = "layouts/post.njk";
const templateClass = "post";
const tags = ["stebrech_en_bookmarks"];
const pagination = {
  data: "bookmarks",
  size: 1,
  alias: "post",
  addAllPagesToCollections: true,
	reverse: true
};
const eleventyComputed = {
	permalink: data => `/en/bookmarks/${data.post.name}/`,
	title: data => data.post.title,
	meta_description: data => data.post.meta_description,
	weblink: data => data.post.url,
	domain: data => data.post.domain,
	og_img_url: data => data.post.og_img_url,
	authors: data => data.post.authors,
	date: data => new Date(data.post.date),
	description_en: data => data.post.description_en,
	tags_en: data => data.post.tags_en,
	languages: data => data.post.languages
}
---
