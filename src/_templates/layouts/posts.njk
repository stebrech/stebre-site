---
layout: layouts/base.njk
---
<header class="header containerM">
  <h1 class="title">{{ title }}</h1>
</header>

{% if content %}
<section class="intro containerM">
	{{ content | safe }}
</section>
{% endif %}

<section class="results containerL">
	{# Card style for posts and projects #}
  <div class="layout-cards">
		{% for post in posts %}

			{% if loop.index == 7 %}
				{# List of all tags. #}
				{% include "includes/navigation/nav_tags.njk" %}
			{% endif %}

			{% include "includes/previews/post.njk" %}
		{% endfor %}
	</div>

	{# Page navigation #}
	{% include "includes/navigation/nav_pagination.njk" %}
</section>
