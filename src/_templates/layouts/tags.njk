---
layout: layouts/base.njk
templateClass: taglist
---
<header class="header containerM">
  <h1 class="title">{{ tag.name }}</h1>
</header>

{% if content %}
<section class="intro containerM">
	{{ content | safe }}
</section>
{% endif %}

<section class="results containerM">
	<h2 class="sectionTitle">{{ i18n.headings.tagContent[page.lang] }} <code>#{{ tag.name }}</code></h2>
	<div class="layout-list">
		{% for post in tag.posts %}
		{% include "includes/previews/post.njk" %}
		{% endfor %}
  </div>
</section>
