---
layout: layouts/base.njk
---
<header class="header containerM">
  <h1 class="title">{{ title }}</h1>
</header>

{% if content %}
<section class="intro containerM">
	{{ content | safe }}
</section>
{% endif %}

<section class="results containerM">

	{# Posts with list style #}
  <div class="layout-list">
		{% for post in posts %}

			{% if loop.index == 7 %}
				{# List of all tags. #}
				{% include "includes/navigation/nav_tags.njk" %}
			{% endif %}

			{% include "includes/previews/bookmark.njk" %}
		{% endfor %}
	</div>

	{# Page navigation #}
	{% include "includes/navigation/nav_pagination.njk" %}
</section>

