<nav class="tagcloud{% if templateClass === "postlist" %} containerM{% endif %}">
	<h2 class="sectionTitle">{{ i18n.headings.tagCloud[page.lang] }}</h2>
	<p>{{ i18n.tagCloudDescription1[page.lang] }} <br>{{ i18n.tagCloudDescription2[page.lang] }}</p>
	<ul>

		{% if page.lang === "en" %}
			{% for tag in collections.tagsEN %}
			<li><a href="/en/tags/{{ tag.name | slug }}/">{{tag.name}}</a> ({{tag.count}})</li>
			{% endfor %}
		{% else %}
			{% for tag in collections.tagsDE %}
			<li><a href="/tags/{{ tag.name | slug }}/">{{tag.name}}</a> ({{tag.count}})</li>
			{% endfor %}
		{% endif %}
	</ul>
</nav>
