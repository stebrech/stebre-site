{
  "name": "stebre_website",
  "private": true,
  "description": "SteBre Website",
  "author": "Stefan Brechbühl",
  "version": "3.1.0",
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@11ty/gray-matter": "^3.0.0",
    "animate.css": "^4.1.1",
    "body-scroll-lock-upgrade": "^1.1.0",
    "clean-css": "^5.3.2",
    "deepl-node": "^1.15.0",
    "dotenv": "^18.0.8",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-obsidian-callouts": "^0.3.1",
    "markdown-it-wikilinks": "^1.4.0",
    "normalize.css": "^8.0.1",
    "path": "^0.12.7",
    "prismjs": "^1.29.0",
    "remove-markdown": "^0.8.0"
  },
  "keywords": [
    "eleventy",
    "blog",
    "11ty"
